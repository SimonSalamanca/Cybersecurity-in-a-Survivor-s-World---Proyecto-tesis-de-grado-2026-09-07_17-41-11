{
  "$schema": "https://opencode.ai/config.json",
  "_nota": "PLANTILLA commiteable. Copiar a opencode.json (ignorado por git) y ajustar. Transporte HTTP = multi-cliente (Opencode, Claude Code, Cursor, Windsurf, VS Code).",
  "mcp": {
    "unityMCP": {
      "type": "remote",
      "url": "http://localhost:8080/mcp",
      "enabled": true,
      "timeout": 15000
    }
  },
  "_fallback_stdio": {
    "cuando_usar": "Si el puerto 8080 esta ocupado o el firewall bloquea HTTP. Requiere Unity abierto + paquete MCP for Unity.",
    "opencode_local": {
      "type": "local",
      "command": ["uvx", "--from", "mcpforunityserver", "mcp-for-unity", "--transport", "stdio"]
    },
    "windows_si_uvx_no_esta_en_PATH": "Usar ruta completa, ej: C:/Users/TU_USUARIO/AppData/Local/Microsoft/WinGet/Links/uvx.exe",
    "otros_clientes_generico": {
      "mcpServers": {
        "unityMCP": { "url": "http://localhost:8080/mcp" }
      }
    }
  }
}
